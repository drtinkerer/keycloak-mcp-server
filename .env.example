# Copy to .env. Discovery-only mode works without Keycloak credentials.
MCP_HOST=localhost
MCP_PORT=5001
MCP_HOST_ENDPOINT=http://localhost:5001
# http and streamable-http both use /mcp; sse is the legacy /sse transport.
# stdio: the MCP client launches the server (`keycloak-mcp-server --stdio`).
MCP_TRANSPORT_PROTOCOL=http
ENABLE_AUTH=False
ENVIRONMENT=development
PYTHON_LOG_LEVEL=INFO

# For browser sign-in, set ENABLE_AUTH=True. MCP clients sign in to Keycloak
# directly with a public keycloak-mcp client; register their loopback callback,
# e.g. http://localhost:9876/* for Claude Code --callback-port 9876
# (see docs/authentication.md). No secret, signing key or storage is needed.
# Base URL before /realms; legacy WildFly distributions add /auth.
KEYCLOAK_SERVER_URL=https://keycloak.example.com
KEYCLOAK_REALM=myrealm
KEYCLOAK_OAUTH_CLIENT_ID=keycloak-mcp
# Add an audience mapper for the client's own ID and require it here.
KEYCLOAK_OAUTH_AUDIENCE=keycloak-mcp
# stdio mode: scopes the server requests when it signs you in.
KEYCLOAK_OAUTH_SCOPES="openid profile email"
KEYCLOAK_TIMEOUT=30
# TLS verification stays enabled; use a PEM bundle for internal certificate issuers.
# KEYCLOAK_CA_BUNDLE=/path/to/trusted-ca-bundle.pem
# Gateways (e.g. ContextForge) whose RFC 8693 exchanged tokens are accepted:
# KEYCLOAK_TRUSTED_EXCHANGERS=["mcp-context-forge"]

# Optional single-user localhost shortcut with ENABLE_AUTH=False only.
# Must be removed before enabling sign-in. No service-account login is performed.
# KEYCLOAK_DEV_ACCESS_TOKEN=

# stdio mode only: the server signs you in itself through the browser.
# Register http://127.0.0.1:<port>/callback on the Keycloak client.
# KEYCLOAK_LOGIN_PORT=8250
# KEYCLOAK_TOKEN_CACHE_DIR=~/.cache/keycloak-mcp-server
