{
  "name": "Keycloak MCP Server",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && \"$HOME/.local/bin/uv\" sync --locked && \"$HOME/.local/bin/uv\" run --locked pre-commit install && if [ ! -f .env ]; then cp .env.example .env; fi",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      },
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "ms-python.debugpy",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "forwardPorts": [
    5001
  ],
  "containerEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.local/bin:${containerEnv:PATH}"
  }
}
